{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ultraviolet swarm manifest",
  "description": "File-ownership manifest for swarm-coordinator. See docs/process/agents-and-swarm.md.",
  "type": "object",
  "required": ["run_id", "started_at", "branches"],
  "properties": {
    "run_id":     { "type": "string", "format": "uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "budget":     {
      "type": "object",
      "properties": {
        "max_tokens":      { "type": "integer", "default": 1000000 },
        "max_wall_seconds":{ "type": "integer", "default": 5400 }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "agent", "owns", "goal", "criterion"],
        "properties": {
          "name":      { "type": "string", "pattern": "^feat/swarm-[a-f0-9-]+/[a-z0-9-]+$" },
          "agent":     { "type": "string" },
          "owns":      { "type": "array", "items": { "type": "string" }, "description": "Glob patterns this branch may touch. Two branches must NEVER claim the same file." },
          "blocks":    { "type": "array", "items": { "type": "string" }, "description": "Branch names that must merge before this one" },
          "goal":      { "type": "string", "minLength": 10 },
          "criterion": { "type": "string", "description": "Test name(s) or manual check that proves done" },
          "status":    { "type": "string", "enum": ["pending","running","gate","merged","failed","aborted"] }
        }
      }
    }
  }
}
